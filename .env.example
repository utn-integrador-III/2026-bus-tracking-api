APP_NAME=Bus Tracking API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

FRONTEND_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

GOOGLE_MAPS_API_KEY=your_google_maps_backend_api_key
GOOGLE_ROUTES_API_URL=https://routes.googleapis.com/directions/v2:computeRoutes

FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

JWT_SECRET_KEY=your_local_development_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

TELEMETRY_UPDATE_INTERVAL_SECONDS=2
MAX_TELEMETRY_DELAY_SECONDS=2

STOP_PROXIMITY_RADIUS_METERS=500
INCIDENT_LIST_WINDOW_MINUTES=60

ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_GOOGLE_ROUTES=true
ENABLE_SUPABASE_REALTIME=true