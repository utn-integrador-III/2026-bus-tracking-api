APP_NAME=Bus Tracking API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

FRONTEND_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

GOOGLE_MAPS_API_KEY=your_google_maps_backend_api_key
GOOGLE_ROUTES_API_URL=https://routes.googleapis.com/directions/v2:computeRoutes

FCM_PROJECT_ID=your_firebase_project_id
FCM_CLIENT_EMAIL=your_firebase_service_account_email
FCM_PRIVATE_KEY=your_multiline_private_key
PUSH_NOTIFICATIONS_ENABLED=false
FCM_VALIDATE_ONLY=true
FCM_BATCH_SIZE=500
FCM_MAX_CONCURRENCY=20
FCM_MAX_BATCHES_PER_RUN=4
NOTIFICATION_QUEUE_BATCH_SIZE=5
NOTIFICATION_EVENT_MAX_AGE_SECONDS=900

JWT_SECRET_KEY=your_local_development_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

TELEMETRY_UPDATE_INTERVAL_SECONDS=2
MAX_TELEMETRY_DELAY_SECONDS=2

STOP_PROXIMITY_RADIUS_METERS=500

ENABLE_GOOGLE_ROUTES=true
ENABLE_SUPABASE_REALTIME=true
